# Clerk publishable key (client-safe, but environment-specific).
# Replace this placeholder with the appropriate Clerk development key locally.
# Production builds must pass their configured key explicitly.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# API base. Leave empty to use the same-origin BFF at /api (production default).
# Set to the apex-gtm-api URL only for direct-upstream dev:
# https://apex-gtm-api.ashysmoke-fd2f7a7f.eastus.azurecontainerapps.io
VITE_API_URL=

# Same-origin BFF authentication (server runtime, not inlined into the browser bundle).
# CLERK_AUTHORIZED_PARTIES is required when NODE_ENV=production. List exact origins only.
CLERK_JWKS_URL=https://your-clerk-instance.example/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.example
CLERK_AUTHORIZED_PARTIES=https://your-app.example
# Optional: leave unset unless the Clerk session JWTs actually include this audience.
# CLERK_AUDIENCE=workforce-api
DEV_TRUST_X_ORG_ID=false
API_UPSTREAM_URL=https://your-api.example

# Dev server (see foundation manifest): PORT + BASE_PATH are required by vite.config.ts
# PORT=21792
# BASE_PATH=/
