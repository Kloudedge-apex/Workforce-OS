# Clerk (publishable key is client-safe).
# PROD: the live instance key below works ONLY on its configured domain (workforceos.xyz).
# LOCAL DEV: a pk_live key rejects localhost (Clerk frontend API 400). Use the instance's
#   pk_test_… (dev) key here for local sign-in, e.g. VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsud29ya2ZvcmNlb3MueHl6JA

# API base. Leave empty to use the same-origin BFF at /api (production default).
